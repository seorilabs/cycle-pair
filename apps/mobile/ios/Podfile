# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Cycle Pair does not use advertising identifiers. Keep Analytics linked
# without AdSupport so telemetry cannot access IDFA.
$RNFirebaseAnalyticsWithoutAdIdSupport = true

# RNFirebase's Objective-C pods currently cannot be compiled as frameworks
# against React Native's prebuilt RNCore. Keep the rest of the graph as static
# frameworks, but make RNFirebase pods static libraries as recommended by the
# RNFirebase maintainers (https://github.com/invertase/react-native-firebase/issues/8883).
pre_install do |installer|
  installer.pod_targets.each do |pod|
    next unless pod.name.start_with?('RNFB')

    def pod.build_type
      Pod::BuildType.static_library
    end
  end
end

target 'CyclePair' do
  config = use_native_modules!

  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
