{
  "schemaVersion": 1,
  "features": [
    {
      "id": "onboarding",
      "core": true,
      "paths": [
        "apps/mobile/src/screens/OnboardingScreen.tsx",
        "apps/mobile/src/screens/SetupScreen.tsx"
      ]
    },
    {
      "id": "records",
      "core": true,
      "foundation": true,
      "paths": [
        "apps/mobile/src/screens/RecordScreen.tsx",
        "apps/mobile/src/platform/local/**",
        "apps/mobile/src/app/CyclePairStore.tsx"
      ]
    },
    {
      "id": "home",
      "core": true,
      "paths": [
        "apps/mobile/src/screens/HomeScreen.tsx",
        "apps/mobile/src/app/cycleViewModel.ts"
      ]
    },
    {
      "id": "pairing-sharing",
      "core": true,
      "foundation": true,
      "paths": [
        "apps/mobile/src/screens/InviteScreen.tsx",
        "apps/mobile/src/screens/SharingScreen.tsx",
        "apps/mobile/src/screens/PartnerScreen.tsx",
        "firebase/firestore.rules",
        "firebase/functions/src/index.ts"
      ]
    },
    {
      "id": "calendar",
      "core": true,
      "paths": [
        "apps/mobile/src/screens/CalendarScreen.tsx",
        "firebase/functions/src/domain/pairEvent.ts"
      ]
    },
    {
      "id": "account",
      "core": true,
      "foundation": true,
      "paths": [
        "apps/mobile/src/platform/account/**",
        "apps/mobile/src/app/account/**",
        "apps/mobile/src/components/AccountSettingsCard.tsx"
      ]
    },
    {
      "id": "notifications",
      "core": true,
      "foundation": true,
      "paths": [
        "apps/mobile/src/platform/notifications/**",
        "firebase/functions/src/domain/notification.ts",
        "firebase/functions/src/domain/partnerNudge.ts"
      ]
    },
    {
      "id": "settings-language",
      "core": true,
      "paths": [
        "apps/mobile/src/screens/SettingsScreen.tsx",
        "apps/mobile/src/i18n/**"
      ]
    },
    {
      "id": "privacy",
      "core": true,
      "foundation": true,
      "paths": [
        "apps/mobile/src/components/PrivacyCenter.tsx",
        "apps/mobile/src/domain/privacy/**",
        "firebase/functions/src/domain/accountLifecycle.ts"
      ]
    },
    {
      "id": "observability",
      "core": false,
      "foundation": true,
      "paths": [
        "apps/mobile/src/platform/observability/**",
        "apps/mobile/src/platform/presence/**"
      ]
    }
  ]
}
